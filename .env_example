# ============================================
# MigrateIQ - Environment Configuration Template
# Copy to `.env` and replace placeholders with your values
# DO NOT commit your actual .env file
# ============================================

# --- PATHS ---
WORKSPACE_PATH=/path/to/your/workspace
SOURCE_PATH=/path/to/your/source
PS_LIBRARY_PATH=/path/to/powershell/library
COMPARE_SCRIPT_PATH=/path/to/CompareX.ps1
SESSIONS_PATH=./data/sessions
LOGS_PATH=./data/logs

# --- COBOL Source ---
COBOL_SOURCE_PATH=/path/to/cobol/source

# --- Validation Tooling ---
COMPARE_COMMAND=compare-x -BaselineName "{baseline_name}" -PromptOnFail $false -GenerateReportOn All

# --- Source Control (Azure DevOps) ---
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_REPO=your-repo
AZURE_DEVOPS_PAT=your-personal-access-token

# --- Local Git Repo ---
GIT_REPO_PATH=/path/to/local/git/repo
GIT_MAIN_BRANCH=main

# ============================================
# LLM Gateway Configuration
# ============================================

# --- Primary LLM Endpoint (unified gateway) ---
# Single endpoint + key for multiple providers (OpenAI / Anthropic / Gemini / Bedrock)
API_URL=https://your-llm-gateway-endpoint/v1/chat/completions
API_KEY=your-api-key-here

# Default model (must match an entry in prompts/model_registry.yaml)
DEFAULT_MODEL=your-default-model-id

# Example model IDs (uncomment/adjust as needed):
# DEFAULT_MODEL=openai/gpt-4.1
# DEFAULT_MODEL=anthropic/claude-sonnet-4
# DEFAULT_MODEL=anthropic/claude-opus-4

# --- Failover LLM Endpoint (Azure OpenAI Direct) ---
# Used automatically if primary API_URL fails
ENSO_AI_API_URL=https://your-azure-openai.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2025-01-01-preview
ENSO_AI_API_KEY=your-azure-openai-key
FALLBACK_MODEL=gpt-4.1

# --- Target Language for Modernization ---
# TARGET_LANGUAGE=java

# ============================================
# Foundry IQ Configuration (Hackathon Track)
# ============================================
FOUNDRY_IQ_ENDPOINT=https://your-foundry-project.services.ai.azure.com/api/projects/your-project-name
FOUNDRY_IQ_API_KEY=your-foundry-api-key-here

# ============================================
# Application Settings
# ============================================
LOG_LEVEL=INFO
# APP_ENV=development
